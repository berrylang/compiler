
class Point {
    attributes[self]::
    int x;
    int y;
    methods::
    Point(int x, int y) {
        self.x = x;
        self.y = y;
    }
}

class Empty {
    attributes[self]::
    int x;
    methods::
    Empty() {
        self.x = 0;
    }
}

func makePoint() -> Point {
    return new Point(7, 8);
}

